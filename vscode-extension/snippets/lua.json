{
  "Cossacks 3: manifest": {
    "prefix": "cs3manifest",
    "description": "Паспорт мода (manifest.lua)",
    "body": [
      "return {",
      "    id = \"${1:my_mod}\",",
      "    name = \"${2:My Mod}\",",
      "    version = \"1.0.0\",",
      "    author = \"${3}\",",
      "    description = \"${4}\",",
      "    client = \"client.lua\",",
      "    multiplayer = \"${5|optional,required|}\",",
      "}"
    ]
  },
  "Cossacks 3: events.on": {
    "prefix": "cs3event",
    "description": "Подписка на событие игры",
    "body": [
      "events.on(\"${1|game.start,game.prepare,game.tick,game.end,game.menu,unit.spawn,unit.death,unit.destroy,building.spawn,building.death,building.destroy,unit.damage,unit.order,player.order,save.loaded|}\", function(event${2:, ...})",
      "\t$0",
      "end)"
    ]
  },
  "Cossacks 3: input.bind": {
    "prefix": "cs3bind",
    "description": "Привязать клавишу (client)",
    "body": [
      "input.bind(\"${1:F6}\", function()",
      "\tif not game.isInGame() then return end",
      "\t$0",
      "end)"
    ]
  },
  "Cossacks 3: balance на старте партии": {
    "prefix": "cs3balance",
    "description": "Изменить статы юнита (shared, game.start)",
    "body": [
      "events.on(\"game.start\", function()",
      "\tbalance.setHP(\"${1:musketeer18}\", ${2:200})",
      "\tbalance.setDamage(\"${1}\", ${3:40}, ${4:1})",
      "end)"
    ]
  },
  "Cossacks 3: клиент просит, хост решает": {
    "prefix": "cs3net",
    "description": "Пара обработчиков net.on для клиента и хоста",
    "body": [
      "-- client.lua",
      "input.bind(\"${1:F6}\", function() net.send(\"${2:request}\", { }) end)",
      "net.on(\"${3:reply}\", function(data) log.info(show(data)) end)",
      "",
      "-- server.lua",
      "net.on(\"${2}\", function(data, from)",
      "\tlocal who = game.playerIndexOf(from)",
      "\tnet.broadcast(\"${3}\", { player = who })",
      "end)"
    ]
  },
  "Cossacks 3: HUD на странице": {
    "prefix": "cs3hud",
    "description": "Открыть web-страницу как HUD (client)",
    "body": [
      "events.on(\"game.start\", function()",
      "\tweb.open(\"${1:hud.html}\")",
      "\tweb.passthrough(true)",
      "end)",
      "events.on(\"game.end\", function() web.close() end)"
    ]
  },
  "Cossacks 3: ui.button": {
    "prefix": "cs3button",
    "description": "Родная кнопка игры",
    "body": [
      "ui.button{ name = \"${1:my_button}\", parent = ${2:0}, text = \"${3:OK}\", x = ${4:20}, y = ${5:20}, w = ${6:120}, h = ${7:32},",
      "\tonClick = function(el)",
      "\t\t$0",
      "\tend }"
    ]
  },
  "Cossacks 3: список своих объектов": {
    "prefix": "cs3objects",
    "description": "Быстрый обход юнитов и зданий игрока",
    "body": [
      "local me = native.GetPlayerIndexInterfaceIO()",
      "for _, h in ipairs(objects.list(me)) do",
      "\tlocal o = objects.read(h)",
      "\tif o and not o.bdead then",
      "\t\t$0",
      "\tend",
      "end"
    ]
  },
  "Cossacks 3: content unit": {
    "prefix": "cs3unit",
    "description": "Новый юнит на основе существующего (content.lua)",
    "body": [
      "unit {",
      "\tsid = \"${1:my_unit}\", from = \"${2:musketeer18}\",",
      "\tnations = { \"${3:ukr}\" },",
      "\tbase = { maxhp = ${4:150}, speed = ${5:1.2} },",
      "\tname = { ru = \"${6}\", en = \"${7}\" },",
      "\tdescription = { ru = \"\", en = \"\" },",
      "}"
    ]
  },
  "Cossacks 3: content nation": {
    "prefix": "cs3nation",
    "description": "Новая нация на основе существующей (content.lua)",
    "body": [
      "nation {",
      "\tsid = \"${1:zap}\", from = \"${2:ukr}\",",
      "\tname = { ru = \"${3}\", en = \"${4}\" },",
      "}"
    ]
  }
}
